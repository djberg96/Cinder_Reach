<% watch_name = @state["watch"] == 2 ? "II" : "I" %>
<% content_for :title, "Cycle #{@state['cycle']} · Watch #{watch_name} — Cinder Reach" %>

<main class="game-shell phase-<%= @state['phase'] %> <%= 'has-played-cards' if @state['played'].any? %> <%= 'has-pending-effect' if @state['pending_effect'].present? %>">
  <header class="command-header">
    <%= link_to root_path, class: "brand-mark" do %>
      <span class="brand-star">✦</span><span><b>CINDER</b> REACH</span>
    <% end %>
    <nav class="header-menu" aria-label="Game information">
      <details class="header-drawer mandate-drawer">
        <summary>Mandate <b><%= @engine.mandate_met? ? "READY" : "#{@state['colonies']}/3" %></b></summary>
        <section class="mandate-card">
          <h2>Make Ark-9 hold.</h2>
          <ul>
            <li class="<%= 'done' if @state['colonies'] >= 3 %>"><i><%= @state['colonies'] >= 3 ? '✓' : '1' %></i><span><b>Establish 3 Colonies</b><small>Required by cycle <%= @engine.cycle_limit %></small></span></li>
            <li class="<%= 'done' if @engine.outer_colonies >= 1 %>"><i><%= @engine.outer_colonies >= 1 ? '✓' : '2' %></i><span><b>Settle the Outer Reach</b><small>At least 1 Outer colony</small></span></li>
            <li class="<%= 'done' if @state['colonies'] >= 4 %>"><i><%= @state['colonies'] >= 4 ? '✓' : '3' %></i><span><b>Lock the Beacon</b><small>4 Colonies wins immediately</small></span></li>
          </ul>
        </section>
      </details>

      <details class="header-drawer log-drawer">
        <summary>Ship's log <b><%= @state["log"].length %></b></summary>
        <section class="log-card">
          <ol>
            <% @state["log"].first(7).each_with_index do |entry, index| %>
              <li class="<%= 'latest' if index.zero? %>"><i></i><span><%= entry %></span></li>
            <% end %>
          </ol>
        </section>
      </details>

      <%= render "rules", header: true %>
    </nav>
    <div class="header-tools">
      <span class="protocol"><i></i><%= @game.difficulty.upcase %></span>
      <%= link_to "Exit", root_path, class: "quiet-link" %>
    </div>
  </header>

  <% if flash.any? %>
    <div class="flash-stack">
      <% flash.each do |type, message| %><div class="flash flash-<%= type %>"><%= message %></div><% end %>
    </div>
  <% end %>

  <section class="command-strip">
    <div class="stat actions-stat">
      <div><span>ACTIONS</span><strong><%= @state["actions"] %><small>/2</small></strong></div>
      <div class="action-pips">
        <% 1.upto(2) do |n| %><i class="<%= 'filled' if n <= @state['actions'] %>">◆</i><% end %>
      </div>
      <small>THIS WATCH</small>
    </div>
    <div class="stat resources-stat">
      <div><span>SUPPLY</span><strong><%= @state["supply"] %></strong><small>THIS CYCLE</small></div>
      <div><span>DATA</span><strong><%= @state["data"] %></strong><small>BANKED</small></div>
    </div>
    <div class="stat stability-stat">
      <div class="stat-heading"><span>STABILITY</span><strong><%= @state["stability"] %><small>/8</small></strong></div>
      <div class="segmented-meter stability-meter">
        <% 1.upto(8) do |n| %><i class="<%= 'filled' if n <= @state['stability'] %>"></i><% end %>
      </div>
      <small>COLLAPSE AT 0</small>
    </div>
    <div class="stat fleet-stat">
      <div class="stat-heading"><span>SILENT FLEET</span><strong><%= @state["fleet"] %><small>/5</small></strong></div>
      <div class="segmented-meter fleet-meter">
        <% 1.upto(5) do |n| %><i class="<%= 'filled' if n <= @state['fleet'] %>"></i><% end %>
      </div>
      <small><%= @state["held"] ? "LANDING HELD" : "INVASION AT 5" %></small>
    </div>
    <div class="stat colony-stat">
      <div class="colony-heading">
        <span>COLONIES</span>
        <strong><%= @state["colonies"] %><small>/4</small></strong>
      </div>
      <div class="colony-pips" data-count="<%= @state['colonies'] %>" aria-label="<%= @state['colonies'] %> of 4 colonies; the fourth locks the beacon">
        <% 1.upto(4) do |n| %>
          <i class="<%= 'filled' if n <= @state['colonies'] %> <%= 'is-goal' if n == 4 %>">
            <span><%= n <= @state["colonies"] ? "⌂" : n == 4 ? "⌾" : n %></span>
            <% if n == 4 %><small>LOCK</small><% end %>
          </i>
        <% end %>
      </div>
    </div>
    <div class="stat grid-stat <%= 'online' if @state['grid'] %>">
      <span class="grid-glyph">⌬</span>
      <div><span>DEFENSE GRID</span><strong><%= @state["grid"] ? "ONLINE" : "OFFLINE" %></strong></div>
    </div>
  </section>

  <% if @game.status != "playing" %>
    <section class="outcome-panel outcome-<%= @game.status %>">
      <span class="outcome-sigil"><%= @game.status == "won" ? "✦" : "×" %></span>
      <span class="micro-label"><%= @game.status == "won" ? "MANDATE SECURED" : "MANDATE FAILED" %></span>
      <h2><%= @game.status == "won" ? "Ark-9 endures." : "The Reach goes dark." %></h2>
      <p><%= @state["outcome"] %></p>
      <div class="final-score"><span>FINAL SCORE</span><strong><%= @engine.score %></strong></div>
      <div class="outcome-actions">
        <%= link_to "New expedition", root_path, class: "primary-button" %>
        <%= button_to "Delete run", game_path(@game), method: :delete, class: "text-button danger-text-button", form: { data: { turbo_confirm: "Permanently delete this run? This cannot be undone." } } %>
      </div>
    </section>
  <% end %>

  <% if @state["pending_effect"] == "listener" %>
    <% signal = @state["glimpse"].first %>
    <section class="decision-panel signal-panel">
      <span class="decision-icon">⌁</span>
      <div class="decision-copy"><span class="micro-label">LISTENER ARRAY / INTERCEPTED SIGNAL</span><h2><%= crisis_data(signal)[:name] %></h2><p><%= crisis_data(signal)[:text] %></p></div>
      <div class="decision-actions">
        <%= button_to "Leave on top", resolve_listener_game_path(@game, decision: "top"), class: "secondary-button" %>
        <%= button_to "Send to bottom", resolve_listener_game_path(@game, decision: "bottom"), class: "primary-button" %>
      </div>
    </section>
  <% elsif @state["pending_effect"] == "black_relay" %>
    <section class="decision-panel signal-panel">
      <span class="decision-icon">⌬</span>
      <div class="decision-copy"><span class="micro-label">BLACK RELAY / TWO SIGNALS FOUND</span><h2>Choose the next crisis</h2><p>The other signal will be sent to the bottom of the crisis deck.</p></div>
      <div class="signal-choices">
        <% @state["glimpse"].each_with_index do |signal, index| %>
          <%= button_to arrange_crises_game_path(@game, top_index: index), class: "signal-choice" do %>
            <b><%= crisis_data(signal)[:name] %></b><span><%= crisis_data(signal)[:text] %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @state["phase"] == "survey_decision" && !@state["pending_effect"] %>
    <% surveyed = world_data(@state["surveyed_world"]) %>
    <% colony_cost = effective_colony_cost(@state, @state["surveyed_world"]) %>
    <section class="decision-panel colony-decision">
      <span class="decision-icon">⌂</span>
      <div class="decision-copy"><span class="micro-label"><%= @state["surveyed_this_action"] ? "SURVEY COMPLETE" : "CHARTED WORLD" %></span><h2><%= surveyed[:name] %> is within reach.</h2><p>Colonization costs <b><%= colony_cost %> Supply</b>. You have <%= @state["supply"] %>.</p></div>
      <div class="decision-actions">
        <%= button_to "Leave orbit", pass_colony_game_path(@game), class: "secondary-button" %>
        <% if @state["surveyed_world"] == "black_relay" %>
          <%= button_to "Colonize · Grid online", colonize_game_path(@game, relay_choice: "grid"), class: "primary-button", disabled: @state["supply"] < colony_cost %>
          <%= button_to "Colonize · Fleet −1", colonize_game_path(@game, relay_choice: "fleet"), class: "primary-button", disabled: @state["supply"] < colony_cost %>
        <% else %>
          <%= button_to(@state["supply"] >= colony_cost ? "Colonize · #{colony_cost}" : "Need #{colony_cost} Supply", colonize_game_path(@game), class: "primary-button", disabled: @state["supply"] < colony_cost) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @state["phase"] == "event" && @state["current_event"] %>
    <% event = event_data(@state["current_event"]) %>
    <section class="event-panel event-<%= event[:tone] %>">
      <div class="event-sigil"><span><%= event[:tone] == 'opportunity' ? '✦' : event[:tone] == 'hazard' ? '!' : '◇' %></span></div>
      <div class="event-copy">
        <span class="micro-label">MIDWATCH EVENT / <%= event[:tone] %></span>
        <h2><%= event[:name] %></h2>
        <p><%= event[:text] %></p>
        <small>Unforeseen events happen between Watches. Command tags cannot block them.</small>
      </div>
      <div class="event-actions">
        <% event[:choices].each do |decision, label| %>
          <%= button_to label, resolve_event_game_path(@game, decision: decision), class: event[:tone] == "hazard" ? "danger-button" : "primary-button" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @state["phase"] == "crisis" && @state["current_crisis"] %>
    <% crisis_key = @state["current_crisis"] %>
    <% crisis = crisis_data(crisis_key) %>
    <section class="crisis-panel">
      <div class="crisis-art"><span>!</span><i></i></div>
      <div class="crisis-body">
        <span class="micro-label">CRISIS / <%= crisis[:threat] %></span>
        <h2><%= crisis[:name] %></h2>
        <p><%= crisis[:text] %></p>
        <% if @state["glimpse"].present? %>
          <small class="intel-line">NEXT SIGNAL: <%= crisis_data(@state["glimpse"].first)[:name] %></small>
        <% end %>
        <div class="crisis-actions">
          <% if %w[harvest_blight deep_signal].include?(crisis_key) %>
            <% if @engine.scrappable_cards.any? %>
              <% @engine.scrappable_cards.each do |pile, index, key| %>
                <%= button_to "Scrap #{card_data(key)[:name]}", resolve_crisis_game_path(@game, decision: "scrap", pile: pile, card_index: index), class: "secondary-button small-button" %>
              <% end %>
            <% end %>
            <%= button_to(crisis_key == "harvest_blight" ? "Lose 1 Stability" : "Advance Fleet", resolve_crisis_game_path(@game, decision: crisis_key == "harvest_blight" ? "stability" : "fleet"), class: "danger-button") %>
          <% else %>
            <%= button_to "Resolve crisis →", resolve_crisis_game_path(@game), class: "danger-button" %>
          <% end %>
        </div>
      </div>
      <aside class="defense-readout">
        <span class="micro-label">CRISIS READINESS</span>
        <% if @engine.crisis_tags.any? %>
          <% @engine.crisis_tags.tally.each do |tag, count| %><span class="tag tag-<%= tag.downcase %>"><%= tag_symbol(tag) %> <%= tag %> ×<%= count %></span><% end %>
        <% else %>
          <em>NO COVER</em>
        <% end %>
      </aside>
    </section>
  <% end %>

  <div class="board-grid">
    <section class="board-main <%= 'awaiting-first-card' if @state['phase'] == 'command' && @state['played'].empty? %>">
      <div class="board-tableau">
        <section class="tableau-panel worlds-panel">
          <div class="section-heading">
            <h2>Worlds in reach</h2>
            <span class="deck-count"><b><%= @state["deep"].length %></b> WORLDS UNCHARTED</span>
          </div>
          <div class="world-row">
            <div class="world-lane-label inner-lane">
              <span><i>●</i><b>Inner Reach</b></span>
              <small>2 WORLD SLOTS</small>
            </div>
            <div class="world-lane-label outer-lane">
              <span><i>◆</i><b>Outer Reach</b></span>
              <small>TECH-GATED</small>
            </div>
            <% @state["system"].each_with_index do |world_key, index| %>
              <% if world_key %><%= render "world", world_key: world_key, index: index %><% end %>
            <% end %>
          </div>
        </section>

        <section class="tableau-panel market-panel">
          <div class="section-heading reach-heading">
            <h2>Market</h2>
            <span class="deck-count"><b><%= @state["market_deck"].length %></b> CARDS REMAIN</span>
          </div>
          <div class="card-row reach-row">
            <% @state["reach"].each_with_index do |key, index| %>
              <% next unless key %>
              <% cost = effective_buy_cost(@state, key) %>
              <%= render "card", card_key: key, cost: cost, index: index, buyable: @state["phase"] == "action", disabled: @state["supply"] < cost || @state["pending_effect"].present? %>
            <% end %>
          </div>
        </section>
      </div>

      <div class="strategy-row">
        <%= render "technology" %>

        <section class="played-zone">
          <div class="played-heading">
            <div><span class="micro-label">ON THE TABLE</span><h2>Command &amp; Support</h2></div>
            <div class="table-controls">
              <% if @state["phase"] == "action" %>
                <%= button_to(@state["watch"] == 1 ? "End Watch I →" : "Face crisis →", end_actions_game_path(@game), class: "#{@state['watch'] == 1 ? 'secondary-button' : 'danger-button'} table-phase-button") %>
              <% end %>
              <div class="table-resources"><span>SUPPLY <b><%= @state["supply"] %></b></span><span>DATA <b><%= @state["data"] %></b></span></div>
            </div>
          </div>
          <div class="table-deployment">
            <section class="command-lane">
              <div class="lane-heading"><b>COMMAND</b><span>CRISIS READINESS</span></div>
              <div class="command-slots">
                <% 2.times do |index| %>
                  <% if (key = @state["played"][index]) %>
                    <div class="command-slot"><%= render "played_card", card_key: key, role: "command" %></div>
                  <% else %>
                    <div class="command-slot is-empty <%= 'is-next' if @state['phase'] == 'command' && index == @state['played'].length %>">
                      <span><b><%= index + 1 %></b><small>COMMAND SLOT</small></span>
                      <em><%= @state["phase"] == "command" && index == @state["played"].length ? "SELECT FROM HAND" : "AWAITING COMMAND" %></em>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </section>
            <section class="support-lane">
              <div class="lane-heading"><b>SUPPORT</b><span>GENERATES RESOURCES</span></div>
              <div class="support-cards">
                <% if @state["support"].any? %>
                  <% @state["support"].each do |key| %><%= render "played_card", card_key: key, role: "support" %><% end %>
                <% else %>
                  <div class="support-placeholder"><span>↓</span><b>Support deploys after both Commands are assigned.</b><small>Remaining cards generate Supply and Data.</small></div>
                <% end %>
              </div>
            </section>
          </div>
          <% if @state["phase"] == "action" %>
            <details class="purge-control table-purge">
              <summary>Purge a card · costs 1 action</summary>
              <div>
                <% { "played" => @state["played"], "support" => @state["support"] }.each do |pile, cards| %>
                  <% cards.each_with_index do |key, index| %>
                    <%= button_to "Purge #{card_data(key)[:name]}", purge_game_path(@game, pile: pile, card_index: index), class: "text-button", disabled: key == "unrest" %>
                  <% end %>
                <% end %>
              </div>
            </details>
          <% end %>
        </section>
      </div>
    </section>

    <aside class="mission-sidebar">
      <%= render "incoming_crisis" %>

      <section class="cycle-panel" aria-label="Cycle <%= @state['cycle'] %> of <%= @engine.cycle_limit %>, Watch <%= watch_name %> of 2">
        <header>
          <div><span class="micro-label">MISSION CLOCK</span><h2>Cycle <%= @state["cycle"] %><small>/<%= @engine.cycle_limit %></small></h2></div>
          <strong>WATCH <%= watch_name %></strong>
        </header>
        <div class="cycle-grid cycle-grid-<%= @engine.cycle_limit %>">
          <% 1.upto(@engine.cycle_limit) do |number| %>
            <span class="cycle-pip <%= 'past' if number < @state['cycle'] %> <%= 'current' if number == @state['cycle'] %>">
              <b><%= number %></b>
              <small>
                <i class="watch-marker <%= 'complete' if number < @state['cycle'] || (number == @state['cycle'] && @state['watch'] == 2) %> <%= 'active' if number == @state['cycle'] && @state['watch'] == 1 %>">I</i>
                <i class="watch-marker <%= 'complete' if number < @state['cycle'] %> <%= 'active' if number == @state['cycle'] && @state['watch'] == 2 %>">II</i>
              </small>
            </span>
          <% end %>
        </div>
        <footer><span>CRISIS RESOLVES</span><b><%= @state["watch"] == 1 ? "AFTER WATCH II" : "AFTER THIS WATCH" %></b></footer>
      </section>
      <% if @state["phase"] == "cleanup" %>
        <%= button_to cleanup_game_path(@game), class: "primary-button mission-advance-button", form: { class: "mission-advance-form" } do %>
          <span><small><%= @state["cycle"] == @engine.cycle_limit ? "FINAL RESOLUTION" : "MISSION CONTINUES" %></small><b><%= @state["cycle"] == @engine.cycle_limit ? "SCORE MANDATE" : "BEGIN CYCLE #{@state['cycle'] + 1}" %></b></span>
          <i>→</i>
        <% end %>
      <% end %>
    </aside>
  </div>

  <% if @state["phase"] == "command" %>
  <section class="hand-zone is-current-focus" data-controller="hand-deal" data-hand-deal-key-value="<%= @game.id %>:<%= @state['cycle'] %>:<%= @state['watch'] %>">
    <div class="section-heading hand-heading">
      <div><span class="micro-label">GOVERNOR'S HAND</span><h2>Your cards <small><%= @state["hand"].length %></small></h2></div>
      <div class="pile-readout"><span class="deck-pile" data-hand-deal-target="deck">DECK <b><%= @state["deck"].length %></b></span><span>DISCARD <b><%= @state["discard"].length %></b></span></div>
    </div>
    <% if @state["hand"].any? %>
      <div class="card-row hand-row">
        <% @state["hand"].each_with_index do |key, index| %>
          <div class="dealt-card" data-hand-deal-target="card"><%= render "card", card_key: key, index: index, playable: true, disabled: @state["pending_effect"].present? %></div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-hand">No cards remain in hand.</div>
    <% end %>
  </section>
  <% end %>
</main>
