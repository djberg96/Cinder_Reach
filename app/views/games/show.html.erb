<% content_for :title, "Cycle #{@state['cycle']} — Cinder Reach" %>

<main class="game-shell">
  <header class="command-header">
    <%= link_to root_path, class: "brand-mark" do %>
      <span class="brand-star">✦</span><span><b>CINDER</b> REACH</span>
    <% end %>
    <div class="cycle-track" aria-label="Cycle <%= @state['cycle'] %> of 10">
      <span class="micro-label">CYCLE</span>
      <div class="cycle-pips">
        <% 1.upto(10) do |number| %>
          <span class="<%= 'past' if number < @state['cycle'] %> <%= 'current' if number == @state['cycle'] %>"><%= number %></span>
        <% end %>
      </div>
    </div>
    <div class="header-tools">
      <span class="protocol"><i></i><%= @game.difficulty.upcase %></span>
      <%= link_to "Exit", root_path, class: "quiet-link" %>
    </div>
  </header>

  <% if flash.any? %>
    <div class="flash-stack">
      <% flash.each do |type, message| %><div class="flash flash-<%= type %>"><%= message %></div><% end %>
    </div>
  <% end %>

  <section class="command-strip">
    <div class="stat supply-stat">
      <span class="stat-icon">⬡</span>
      <div><span>SUPPLY</span><strong><%= @state["supply"] %></strong></div>
      <small>THIS CYCLE</small>
    </div>
    <div class="stat stability-stat">
      <div class="stat-heading"><span>STABILITY</span><strong><%= @state["stability"] %><small>/8</small></strong></div>
      <div class="segmented-meter stability-meter">
        <% 1.upto(8) do |n| %><i class="<%= 'filled' if n <= @state['stability'] %>"></i><% end %>
      </div>
      <small>COLLAPSE AT 0</small>
    </div>
    <div class="stat fleet-stat">
      <div class="stat-heading"><span>SILENT FLEET</span><strong><%= @state["fleet"] %><small>/5</small></strong></div>
      <div class="segmented-meter fleet-meter">
        <% 1.upto(5) do |n| %><i class="<%= 'filled' if n <= @state['fleet'] %>"></i><% end %>
      </div>
      <small><%= @state["held"] ? "LANDING HELD" : "INVASION AT 5" %></small>
    </div>
    <div class="stat colony-stat">
      <span>COLONIES</span>
      <div class="colony-pips">
        <% 1.upto(4) do |n| %><i class="<%= 'filled' if n <= @state['colonies'] %>">⌂</i><% end %>
      </div>
      <small><%= @state["colonies"] %>/4 · LOCK AT 4</small>
    </div>
    <div class="stat grid-stat <%= 'online' if @state['grid'] %>">
      <span class="grid-glyph">⌬</span>
      <div><span>DEFENSE GRID</span><strong><%= @state["grid"] ? "ONLINE" : "OFFLINE" %></strong></div>
    </div>
  </section>

  <% phase_labels = {
    "play" => ["01", "PLAY & COMMIT", "Play cards, gather Supply, then choose one main action."],
    "survey_decision" => ["02", "COLONY DECISION", "Your survey is complete. Establish a colony or leave orbit."],
    "crisis" => ["03", "INCOMING CRISIS", "Your cards remain in play. Resolve what the system sends."],
    "cleanup" => ["04", "CYCLE COMPLETE", "Discard the table, lose unspent Supply, and draw a new hand."],
    "finished" => ["—", "TRANSMISSION ENDED", "Review the final mandate report."]
  } %>
  <% phase_data = phase_labels.fetch(@state["phase"]) %>
  <section class="phase-banner">
    <span class="phase-number"><%= phase_data[0] %></span>
    <div><span class="micro-label">CURRENT PHASE</span><h2><%= phase_data[1] %></h2><p><%= phase_data[2] %></p></div>
    <% if @state["phase"] == "play" && @state["hand"].any? && !@state["pending_effect"] %>
      <%= button_to "Play all cards", play_all_game_path(@game), class: "secondary-button" %>
    <% elsif @state["phase"] == "cleanup" %>
      <%= button_to(@state["cycle"] == 10 ? "Score mandate →" : "Begin cycle #{@state['cycle'] + 1} →", cleanup_game_path(@game), class: "primary-button") %>
    <% end %>
  </section>

  <% if @game.status != "playing" %>
    <section class="outcome-panel outcome-<%= @game.status %>">
      <span class="outcome-sigil"><%= @game.status == "won" ? "✦" : "×" %></span>
      <span class="micro-label"><%= @game.status == "won" ? "MANDATE SECURED" : "MANDATE FAILED" %></span>
      <h2><%= @game.status == "won" ? "Ark-9 endures." : "The Reach goes dark." %></h2>
      <p><%= @state["outcome"] %></p>
      <div class="final-score"><span>FINAL SCORE</span><strong><%= @engine.score %></strong></div>
      <div class="outcome-actions">
        <%= link_to "New expedition", root_path, class: "primary-button" %>
        <%= button_to "Archive this run", game_path(@game), method: :delete, class: "text-button", form: { data: { turbo_confirm: "Archive this run?" } } %>
      </div>
    </section>
  <% end %>

  <% if @state["pending_effect"] == "listener" %>
    <% signal = @state["glimpse"].first %>
    <section class="decision-panel signal-panel">
      <span class="decision-icon">⌁</span>
      <div class="decision-copy"><span class="micro-label">LISTENER ARRAY / INTERCEPTED SIGNAL</span><h2><%= crisis_data(signal)[:name] %></h2><p><%= crisis_data(signal)[:text] %></p></div>
      <div class="decision-actions">
        <%= button_to "Leave on top", resolve_listener_game_path(@game, decision: "top"), class: "secondary-button" %>
        <%= button_to "Send to bottom", resolve_listener_game_path(@game, decision: "bottom"), class: "primary-button" %>
      </div>
    </section>
  <% elsif @state["pending_effect"] == "black_relay" %>
    <section class="decision-panel signal-panel">
      <span class="decision-icon">⌬</span>
      <div class="decision-copy"><span class="micro-label">BLACK RELAY / TWO SIGNALS FOUND</span><h2>Choose the next crisis</h2><p>The other signal will be sent to the bottom of the crisis deck.</p></div>
      <div class="signal-choices">
        <% @state["glimpse"].each_with_index do |signal, index| %>
          <%= button_to arrange_crises_game_path(@game, top_index: index), class: "signal-choice" do %>
            <b><%= crisis_data(signal)[:name] %></b><span><%= crisis_data(signal)[:text] %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @state["phase"] == "survey_decision" && !@state["pending_effect"] %>
    <% surveyed = world_data(@state["surveyed_world"]) %>
    <section class="decision-panel colony-decision">
      <span class="decision-icon">⌂</span>
      <div class="decision-copy"><span class="micro-label">SURVEY COMPLETE</span><h2><%= surveyed[:name] %> is within reach.</h2><p>Colonization costs <b><%= surveyed[:colony] %> Supply</b>. You have <%= @state["supply"] %>.</p></div>
      <div class="decision-actions">
        <%= button_to "Leave orbit", pass_colony_game_path(@game), class: "secondary-button" %>
        <% if @state["surveyed_world"] == "black_relay" %>
          <%= button_to "Colonize · Grid online", colonize_game_path(@game, relay_choice: "grid"), class: "primary-button", disabled: @state["supply"] < surveyed[:colony] %>
          <%= button_to "Colonize · Fleet −1", colonize_game_path(@game, relay_choice: "fleet"), class: "primary-button", disabled: @state["supply"] < surveyed[:colony] %>
        <% else %>
          <%= button_to(@state["supply"] >= surveyed[:colony] ? "Colonize · #{surveyed[:colony]}" : "Need #{surveyed[:colony]} Supply", colonize_game_path(@game), class: "primary-button", disabled: @state["supply"] < surveyed[:colony]) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @state["phase"] == "crisis" && @state["current_crisis"] %>
    <% crisis_key = @state["current_crisis"] %>
    <% crisis = crisis_data(crisis_key) %>
    <section class="crisis-panel">
      <div class="crisis-art"><span>!</span><i></i></div>
      <div class="crisis-body">
        <span class="micro-label">CRISIS / <%= crisis[:threat] %></span>
        <h2><%= crisis[:name] %></h2>
        <p><%= crisis[:text] %></p>
        <% if @state["glimpse"].present? %>
          <small class="intel-line">NEXT SIGNAL: <%= crisis_data(@state["glimpse"].first)[:name] %></small>
        <% end %>
        <div class="crisis-actions">
          <% if %w[harvest_blight deep_signal].include?(crisis_key) %>
            <% if @state["hand"].any? %>
              <% @state["hand"].each_with_index do |key, index| %>
                <%= button_to "Scrap #{card_data(key)[:name]}", resolve_crisis_game_path(@game, decision: "scrap", card_index: index), class: "secondary-button small-button" %>
              <% end %>
            <% end %>
            <%= button_to(crisis_key == "harvest_blight" ? "Lose 1 Stability" : "Advance Fleet", resolve_crisis_game_path(@game, decision: crisis_key == "harvest_blight" ? "stability" : "fleet"), class: "danger-button") %>
          <% else %>
            <%= button_to "Resolve crisis →", resolve_crisis_game_path(@game), class: "danger-button" %>
          <% end %>
        </div>
      </div>
      <aside class="defense-readout">
        <span class="micro-label">TAGS IN PLAY</span>
        <% if @engine.tags.any? %>
          <% @engine.tags.tally.each do |tag, count| %><span class="tag tag-<%= tag.downcase %>"><%= tag_symbol(tag) %> <%= tag %> ×<%= count %></span><% end %>
        <% else %>
          <em>NO COVER</em>
        <% end %>
      </aside>
    </section>
  <% end %>

  <div class="board-grid">
    <section class="board-main">
      <div class="section-heading">
        <div><span class="micro-label">VISIBLE SYSTEM</span><h2>Worlds in reach</h2></div>
        <span class="deck-count"><b><%= @state["deep"].length %></b> WORLDS IN THE DEEP</span>
      </div>
      <div class="world-row">
        <% @state["system"].each_with_index do |world_key, index| %>
          <% if world_key %><%= render "world", world_key: world_key, index: index %><% end %>
        <% end %>
      </div>

      <div class="section-heading reach-heading">
        <div><span class="micro-label">MARKET</span><h2>The Reach</h2></div>
        <span class="deck-count"><b><%= @state["market_deck"].length %></b> CARDS REMAIN</span>
      </div>
      <div class="card-row reach-row">
        <% @state["reach"].each_with_index do |key, index| %>
          <% next unless key %>
          <% cost = effective_buy_cost(@state, key) %>
          <%= render "card", card_key: key, cost: cost, index: index, buyable: @state["phase"] == "play", disabled: @state["supply"] < cost || @state["pending_effect"].present? %>
        <% end %>
      </div>
    </section>

    <aside class="mission-sidebar">
      <section class="mandate-card">
        <span class="micro-label">GOVERNOR'S MANDATE</span>
        <h2>Make Ark-9 hold.</h2>
        <ul>
          <li class="<%= 'done' if @state['colonies'] >= 2 %>"><i><%= @state['colonies'] >= 2 ? '✓' : '1' %></i><span><b>Establish 2 Colonies</b><small>Required by cycle 10</small></span></li>
          <li class="<%= 'done' if @state['grid'] %>"><i><%= @state['grid'] ? '✓' : '2' %></i><span><b>Activate the Grid</b><small>Required to survive Fleet 5</small></span></li>
          <li class="<%= 'done' if @state['colonies'] >= 4 %>"><i><%= @state['colonies'] >= 4 ? '✓' : '3' %></i><span><b>Lock the Beacon</b><small>4 Colonies wins immediately</small></span></li>
        </ul>
      </section>

      <section class="log-card">
        <div class="section-heading compact"><div><span class="micro-label">SHIP'S LOG</span><h2>Latest events</h2></div></div>
        <ol>
          <% @state["log"].first(7).each_with_index do |entry, index| %>
            <li class="<%= 'latest' if index.zero? %>"><i></i><span><%= entry %></span></li>
          <% end %>
        </ol>
      </section>

      <%= render "rules" %>
    </aside>
  </div>

  <section class="hand-zone">
    <div class="section-heading hand-heading">
      <div><span class="micro-label">GOVERNOR'S HAND</span><h2>Your cards <small><%= @state["hand"].length %></small></h2></div>
      <div class="pile-readout"><span>DECK <b><%= @state["deck"].length %></b></span><span>DISCARD <b><%= @state["discard"].length %></b></span></div>
    </div>
    <% if @state["hand"].any? %>
      <div class="card-row hand-row">
        <% @state["hand"].each_with_index do |key, index| %>
          <%= render "card", card_key: key, index: index, playable: @state["phase"] == "play", disabled: @state["pending_effect"].present? %>
        <% end %>
      </div>
      <% if @state["phase"] == "play" && !@state["pending_effect"] %>
        <details class="purge-control">
          <summary>Purge a card instead of buying or surveying</summary>
          <div>
            <% @state["hand"].each_with_index do |key, index| %>
              <%= button_to "Purge #{card_data(key)[:name]}", purge_game_path(@game, card_index: index), class: "text-button", disabled: key == "unrest" %>
            <% end %>
          </div>
        </details>
      <% end %>
    <% else %>
      <div class="empty-hand">No cards remain in hand.</div>
    <% end %>
  </section>
</main>
