<% content_for :title, "Cinder Reach — Solo Deck-Builder" %>

<main class="landing-shell">
  <% if flash.any? %>
    <div class="flash-stack" role="status" aria-live="polite">
      <% flash.each do |type, message| %><div class="flash flash-<%= type %>"><span><%= message %></span></div><% end %>
    </div>
  <% end %>

  <section class="landing-hero">
    <div class="eyebrow"><span></span> ARK-9 / GOVERNOR'S TERMINAL <span></span></div>
    <h1>CINDER<br><em>REACH</em></h1>
    <p class="dispatch">Eight cycles. Two Watches each. No quiet crossing.</p>
    <p class="premise">Build your colony deck, open the Outer Reach, survive unforeseen events, and prepare for the landing before time runs out.</p>

    <% if @current_game %>
      <div class="continue-panel">
        <div class="continue-copy">
          <span class="micro-label">ACTIVE TRANSMISSION</span>
          <strong>Cycle <%= [@current_game.state["cycle"], @current_game.state["cycle_limit"] || 10].min %> · <%= @current_game.difficulty.titleize %> protocol</strong>
        </div>
        <div class="continue-actions">
          <%= link_to @current_game.status == "playing" ? "Continue run" : "Review run", game_path(@current_game), class: "primary-button" %>
          <%= button_to "Delete run", game_path(@current_game), method: :delete, class: "text-button danger-text-button", form: { data: { turbo_confirm: "Permanently delete this run? This cannot be undone." } } %>
        </div>
      </div>
    <% end %>

    <div class="new-run">
      <h2>Issue a new mandate</h2>
      <%= form_with url: games_path, class: "difficulty-form" do |form| %>
        <label class="difficulty-option">
          <%= form.radio_button :difficulty, "prospect" %>
          <span class="difficulty-card">
            <span class="difficulty-top"><b>Prospect</b><small>Forgiving</small></span>
            <span>10 cycles, more favorable events, and 6 Stability.</span>
          </span>
        </label>
        <label class="difficulty-option">
          <%= form.radio_button :difficulty, "mandate", checked: true %>
          <span class="difficulty-card featured">
            <span class="difficulty-top"><b>Mandate</b><small>Standard</small></span>
            <span>8 cycles, a balanced event deck, and 5 Stability.</span>
          </span>
        </label>
        <label class="difficulty-option">
          <%= form.radio_button :difficulty, "silent" %>
          <span class="difficulty-card">
            <span class="difficulty-top"><b>Silent</b><small>Severe</small></span>
            <span>8 cycles, harsher events. Fleet begins at 1.</span>
          </span>
        </label>
        <%= form.submit "Begin expedition  →", class: "primary-button launch-button" %>
      <% end %>
    </div>

    <div class="landing-footer">
      <span>SOLO DECK-BUILDER</span><i></i><span>20–30 MINUTES</span><i></i><span>8 CYCLES · 2 WATCHES EACH</span>
    </div>
  </section>

  <aside class="planet-window" aria-hidden="true">
    <div class="orbit orbit-one"></div>
    <div class="orbit orbit-two"></div>
    <div class="planet"><div class="planet-glow"></div></div>
    <div class="ship ship-one">✦</div>
    <div class="ship ship-two">·</div>
    <div class="coordinate">CR-09<br>41.072° N<br>BEACON: WEAK</div>
  </aside>
</main>
