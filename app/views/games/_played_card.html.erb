<% data = card_data(card_key) %>
<% role = local_assigns.fetch(:role, "command") %>
<article class="game-card played-card role-<%= role %> card-<%= card_tone(data[:tag]) %>">
  <div class="card-sigil" aria-hidden="true"><%= tag_symbol(data[:tag]) || "×" %></div>
  <header>
    <div>
      <span class="card-kind"><%= role.upcase %></span>
      <h3><%= data[:name] %></h3>
    </div>
    <% if role == "support" %>
      <strong class="played-yield"><%= data[:supply] %>S · <%= data[:data] %>D<small>GENERATED</small></strong>
    <% else %>
      <strong class="played-yield"><%= tag_symbol(data[:tag]) || "×" %><small>COMMAND</small></strong>
    <% end %>
  </header>
  <div class="card-art" aria-hidden="true">
    <span class="art-orbit"></span><span class="art-core"></span><span class="art-line"></span>
  </div>
  <div class="card-copy">
    <% if data[:tag] %><span class="tag tag-<%= data[:tag].downcase %>"><%= tag_symbol(data[:tag]) %> <%= data[:tag] %></span><% end %>
    <p><%= role == "support" ? "Generated #{data[:supply]} Supply and #{data[:data]} Data." : data[:command_text] %></p>
  </div>
</article>
