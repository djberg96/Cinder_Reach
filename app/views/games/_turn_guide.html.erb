<% case @state["phase"]
   when "command"
     command_number = [ @state["played"].length + 1, 2 ].min
     guide_step = "YOUR TURN · COMMAND #{command_number}/2"
     guide_icon = "↓"
     guide_title = @state["pending_effect"].present? ? "Resolve the signal" : "Choose a command"
     guide_reminder = if @state["pending_effect"].present?
       "Finish the highlighted Command effect before choosing another card."
     else
       "Choose two cards as Commands. Their abilities and crisis tags activate; every remaining card becomes Support and generates Supply and banked Data."
     end
   when "action"
     guide_step = "YOUR TURN · #{@state['actions']} ACTIONS LEFT"
     guide_icon = "◇"
     guide_title = "Take an action"
     guide_reminder = "Spend Supply to buy cards or colonize. Spend Data to survey or research. You may repeat an action, or purge a card from this cycle."
   when "survey_decision"
     guide_step = "WORLD ACTION"
     guide_icon = "⌂"
     guide_title = "Colonize or leave"
     guide_reminder = "The survey is permanent. Colonize now with Supply or return in a later cycle without paying Data again."
   when "crisis"
     guide_step = "SYSTEM RESPONSE"
     guide_icon = "!"
     guide_title = "Resolve the crisis"
     guide_reminder = "Only your two Command cards provide crisis tags and protection."
   when "cleanup"
     guide_step = "END OF CYCLE"
     guide_icon = "↻"
     guide_title = "Cycle complete"
     guide_reminder = "Commands and Support discard. Supply normally expires; banked Data remains."
   else
     guide_step = "RUN COMPLETE"
     guide_icon = "✦"
     guide_title = "Run complete"
     guide_reminder = "The final mandate report appears above the table."
   end %>

<section class="turn-guide guide-<%= @state['phase'] %>">
  <span class="guide-step"><%= guide_step %></span>
  <div class="guide-main">
    <span class="guide-icon <%= 'danger-icon' if @state['phase'] == 'crisis' %>"><%= guide_icon %></span>
    <h2><%= guide_title %></h2>
    <span class="guide-help" tabindex="0" aria-label="Show rules reminder">?</span>
    <span class="guide-tooltip" role="tooltip"><%= guide_reminder %></span>
  </div>

  <% if @state["phase"] == "action" %>
    <div class="guide-resources"><span>SUPPLY <b><%= @state["supply"] %></b></span><span>DATA <b><%= @state["data"] %></b></span></div>
    <%= button_to "End actions · face crisis", end_actions_game_path(@game), class: "text-button guide-end-button" %>
  <% elsif @state["phase"] == "survey_decision" %>
    <div class="guide-resources"><span>SUPPLY <b><%= @state["supply"] %></b></span><span>ACTIONS <b><%= @state["actions"] %></b></span></div>
  <% elsif @state["phase"] == "cleanup" %>
    <%= button_to(@state["cycle"] == 10 ? "Score mandate →" : "Begin cycle #{@state['cycle'] + 1} →", cleanup_game_path(@game), class: "primary-button guide-button") %>
  <% end %>
</section>
