  <% signal_key = @state["incoming_crisis"] %>
<% if signal_key && %w[command action].include?(@state["phase"]) %>
  <% signal = crisis_data(signal_key) %>
  <% display = signal[:display] %>
  <section class="incoming-crisis threat-<%= signal[:threat].downcase %>">
    <header class="crisis-card-header">
      <span class="card-kind">CRISIS CARD</span>
      <b><%= signal[:threat] %></b>
    </header>
    <div class="crisis-card-art" aria-hidden="true">
      <span class="crisis-art-orbit"></span>
      <span class="crisis-art-core">!</span>
    </div>
    <div class="crisis-card-copy">
      <span class="incoming-status"><i class="incoming-pulse"></i><%= @state["watch"] == 1 ? "RESOLVES AFTER WATCH II" : "RESOLVES AFTER THIS WATCH" %></span>
      <div class="crisis-title-row">
        <h2><%= signal[:name] %></h2>
        <span class="crisis-help" tabindex="0" aria-label="What is a crisis card?">?</span>
        <span class="crisis-tooltip" role="tooltip"><b>CRISIS CARD</b>This threat remains visible for both Watches. Command tags from either Watch enter Readiness and can satisfy its block condition.</span>
      </div>
      <div class="crisis-effect <%= 'has-defense' if display[:defense] %>">
        <% if display[:defense] %>
          <span class="crisis-defense">
            <i><%= display.dig(:defense, :symbol) %></i>
            <span><small><%= display.dig(:defense, :caption) || "BLOCK WITH" %></small><b><%= display.dig(:defense, :label) %></b></span>
          </span>
          <span class="effect-or">OR</span>
        <% end %>
        <span class="effect-results <%= 'multi-effect' if display[:effects].length > 1 %>">
          <% display[:effects].each_with_index do |effect, index| %>
            <% if index.positive? %><em><%= display[:join] || "AND" %></em><% end %>
            <b><%= effect %></b>
          <% end %>
        </span>
      </div>
      <% if display[:note] %><span class="effect-note"><%= display[:note] %></span><% end %>
      <% if @engine.crisis_tags.any? %>
        <span class="crisis-readiness"><small>READINESS</small><span><% @engine.crisis_tags.tally.each do |tag, count| %><b><%= tag_symbol(tag) %> <%= tag %> ×<%= count %></b><% end %></span></span>
      <% end %>
      <% if (@engine.tech?("def_analysis") || @state["colonized_worlds"].include?("black_relay")) && @state["glimpse"].present? %>
        <% next_signal = crisis_data(@state["glimpse"].first) %>
        <% next_display = next_signal[:display] %>
        <div class="crisis-intel">
          <span class="crisis-intel-trigger" tabindex="0" aria-label="Preview next crisis: <%= next_signal[:name] %>">
            <i>⌁</i>
            <span><small>DEEP INTEL</small><b><%= next_signal[:name] %></b></span>
            <em>NEXT</em>
          </span>
          <article class="crisis-preview-card threat-<%= next_signal[:threat].downcase %>" role="tooltip">
            <header><span>NEXT CRISIS</span><b><%= next_signal[:threat] %></b></header>
            <div class="crisis-preview-art" aria-hidden="true"><i></i><b>!</b></div>
            <div class="crisis-preview-copy">
              <h3><%= next_signal[:name] %></h3>
              <div class="crisis-preview-effect">
                <% if next_display[:defense] %>
                  <span><small><%= next_display.dig(:defense, :caption) || "BLOCK WITH" %></small><b><%= next_display.dig(:defense, :label) %></b></span>
                <% end %>
                <span class="preview-effect-results"><% next_display[:effects].each do |effect| %><b><%= effect %></b><% end %></span>
              </div>
              <% if next_display[:note] %><p><%= next_display[:note] %></p><% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
