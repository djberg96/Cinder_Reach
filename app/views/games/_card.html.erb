<% data = card_data(card_key) %>
<% playable = local_assigns.fetch(:playable, false) %>
<% actionable = (playable || local_assigns[:buyable]) && !local_assigns[:disabled] %>
<article class="game-card card-<%= card_tone(data[:tag]) %> <%= 'is-disabled' if local_assigns[:disabled] %> <%= 'is-actionable' if actionable %>">
  <div class="card-sigil" aria-hidden="true"><%= tag_symbol(data[:tag]) || "×" %></div>
  <header>
    <div>
      <span class="card-kind"><%= data[:kind] || "REACH" %></span>
      <h3><%= data[:name] %></h3>
    </div>
    <% if local_assigns[:cost] %><span class="card-cost"><%= cost %></span><% end %>
  </header>
  <div class="card-art" aria-hidden="true">
    <span class="art-orbit"></span><span class="art-core"></span><span class="art-line"></span>
  </div>
  <div class="card-copy">
    <% if data[:tag] %><span class="tag tag-<%= data[:tag].downcase %>"><%= tag_symbol(data[:tag]) %> <%= data[:tag] %></span><% end %>
    <div class="card-modes">
      <p><b>COMMAND</b> <%= data[:command_text] %></p>
      <span><b>SUPPORT</b> <%= data[:supply] %> Supply · <%= data[:data] %> Data</span>
    </div>
  </div>
  <% if playable %>
    <span class="card-action-label"><%= local_assigns[:disabled] ? "WAITING" : "ASSIGN AS COMMAND" %></span>
    <%= button_to "", play_card_game_path(@game, card_index: local_assigns[:index]), class: "card-hit-area", disabled: local_assigns[:disabled], form: { class: "card-hit-form" }, aria: { label: "Assign #{data[:name]} as a Command" } %>
  <% elsif local_assigns[:buyable] %>
    <span class="card-action-label"><%= local_assigns[:disabled] ? "COST #{cost}" : "BUY · #{cost} SUPPLY" %></span>
    <%= button_to "", buy_game_path(@game, slot: local_assigns[:index]), class: "card-hit-area", disabled: local_assigns[:disabled], form: { class: "card-hit-form" }, aria: { label: "Buy #{data[:name]} for #{cost} Supply" } %>
  <% end %>
</article>
